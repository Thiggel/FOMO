\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Conceptual overview of BRIDGE. We alternate between SSL pretraining, sparsity scoring in representation space, and targeted image-to-image diffusion augmentation. The final method augments the modal sparse band of the OOD-distance distribution rather than the extreme tail.\relax }}{1}{figure.1}\protected@file@percent }
\newlabel{fig:bridge-overview}{{1}{1}{Conceptual overview of BRIDGE. We alternate between SSL pretraining, sparsity scoring in representation space, and targeted image-to-image diffusion augmentation. The final method augments the modal sparse band of the OOD-distance distribution rather than the extreme tail.\relax }{figure.1}{}}
