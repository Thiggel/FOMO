\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Selector robustness on ImageNet-100-LT. Each row changes one component of the acquisition rule -- candidate pool multiplier, upper cutoff, neighbourhood size, distance, or selection strategy -- and holds the rest of the loop fixed. Mean $\pm $ standard deviation over three seeds. Cosine scoring rescales the normalized $L_2$ score by a positive constant and therefore selects the identical anchor set; that row is a null control, and its distance from the normalized $L_2$ row measures the end-to-end run-to-run spread of the pipeline. Linear-probe accuracy.}}{21}{table.caption.55}\protected@file@percent }
\newlabel{tab:selector-robustness-full-linear}{{20}{21}{Selector robustness on ImageNet-100-LT. Each row changes one component of the acquisition rule -- candidate pool multiplier, upper cutoff, neighbourhood size, distance, or selection strategy -- and holds the rest of the loop fixed. Mean $\pm $ standard deviation over three seeds. Cosine scoring rescales the normalized $L_2$ score by a positive constant and therefore selects the identical anchor set; that row is a null control, and its distance from the normalized $L_2$ row measures the end-to-end run-to-run spread of the pipeline. Linear-probe accuracy}{table.caption.55}{}}
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces Selector robustness on ImageNet-100-LT. Each row changes one component of the acquisition rule -- candidate pool multiplier, upper cutoff, neighbourhood size, distance, or selection strategy -- and holds the rest of the loop fixed. Mean $\pm $ standard deviation over three seeds. Cosine scoring rescales the normalized $L_2$ score by a positive constant and therefore selects the identical anchor set; that row is a null control, and its distance from the normalized $L_2$ row measures the end-to-end run-to-run spread of the pipeline. $k$NN accuracy.}}{21}{table.caption.56}\protected@file@percent }
\newlabel{tab:selector-robustness-full-knn}{{21}{21}{Selector robustness on ImageNet-100-LT. Each row changes one component of the acquisition rule -- candidate pool multiplier, upper cutoff, neighbourhood size, distance, or selection strategy -- and holds the rest of the loop fixed. Mean $\pm $ standard deviation over three seeds. Cosine scoring rescales the normalized $L_2$ score by a positive constant and therefore selects the identical anchor set; that row is a null control, and its distance from the normalized $L_2$ row measures the end-to-end run-to-run spread of the pipeline. $k$NN accuracy}{table.caption.56}{}}
