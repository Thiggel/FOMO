\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Linear-probe transfer for five source regimes, three label-derived long-tailed sources and two 10k web corpora, on seven downstream tasks, mean $\pm $ standard deviation over three seeds. Every method pretrains on the source in the left column under the same schedule. The shaded row is BRIDGE\ and bold marks the best value in a column, without resolving overlapping standard deviations. Hybrids of BRIDGE\ with TS and SDCLR are in Appendix Tables~\ref {tab:app_sota_linear_full} and~\ref {tab:app_sota_knn_full}.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:main_transfer_linear}{{1}{6}{Linear-probe transfer for five source regimes, three label-derived long-tailed sources and two 10k web corpora, on seven downstream tasks, mean $\pm $ standard deviation over three seeds. Every method pretrains on the source in the left column under the same schedule. The shaded row is \method \ and bold marks the best value in a column, without resolving overlapping standard deviations. Hybrids of \method \ with TS and SDCLR are in Appendix Tables~\ref {tab:app_sota_linear_full} and~\ref {tab:app_sota_knn_full}}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces $k$NN transfer for the five source regimes and methods of Table~\ref {tab:main_transfer_linear}, classified by $k$NN on frozen features without a learned probe. Mean $\pm $ standard deviation over three seeds, shading and bold as in Table~\ref {tab:main_transfer_linear}.}}{6}{table.caption.9}\protected@file@percent }
\newlabel{tab:main_transfer_knn}{{2}{6}{$k$NN transfer for the five source regimes and methods of Table~\ref {tab:main_transfer_linear}, classified by $k$NN on frozen features without a learned probe. Mean $\pm $ standard deviation over three seeds, shading and bold as in Table~\ref {tab:main_transfer_linear}}{table.caption.9}{}}
