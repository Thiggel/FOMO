\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ablations on ImageNet-100-LT under the full five-cycle protocol, linear-probe accuracy, mean and standard deviation over three seeds. Each block changes one component, and its shaded row is the default. The selection, cycle and backbone blocks share one default run (42.3) and the generator block's default is a separate run set (41.5), a gap inside seed variation. Bold marks the best competing setting in a column, excluding the oracle row, which is the oracle of Section~\ref {sec:setup} restoring the withheld real images. Table~\ref {tab:main_transfer_linear} reports the same configuration from a separate export, and the two differ by up to 1.2 points on Cars. $k$NN counterparts are in Appendix Table~\ref {tab:main_ablation_combined_knn}.}}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:main_ablation_combined}{{4}{8}{Ablations on ImageNet-100-LT under the full five-cycle protocol, linear-probe accuracy, mean and standard deviation over three seeds. Each block changes one component, and its shaded row is the default. The selection, cycle and backbone blocks share one default run (42.3) and the generator block's default is a separate run set (41.5), a gap inside seed variation. Bold marks the best competing setting in a column, excluding the oracle row, which is the oracle of Section~\ref {sec:setup} restoring the withheld real images. Table~\ref {tab:main_transfer_linear} reports the same configuration from a separate export, and the two differ by up to 1.2 points on Cars. $k$NN counterparts are in Appendix Table~\ref {tab:main_ablation_combined_knn}}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Fixed-encoder intervention test. With the cycle-0 encoder frozen and every generated image inserted into the $k$NN index, the radius of the treated anchors falls about twice as far as that of matched controls, so the variants land in their own anchors' neighborhoods. Purity falls about a third as much at the anchors. Bars are the mean over seeds and the error bars are one standard deviation.}}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:fixed-support}{{3}{8}{Fixed-encoder intervention test. With the cycle-0 encoder frozen and every generated image inserted into the $k$NN index, the radius of the treated anchors falls about twice as far as that of matched controls, so the variants land in their own anchors' neighborhoods. Purity falls about a third as much at the anchors. Bars are the mean over seeds and the error bars are one standard deviation}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Score distribution over the four repair cycles of one ImageNet-100-LT run, with the 75th to 99th percentile band shaded and its modal bin marked. The distribution shifts to larger scores and broadens at every cycle, so the band is re-derived from the current representation.}}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:cycle-histograms-main}{{4}{8}{Score distribution over the four repair cycles of one ImageNet-100-LT run, with the 75th to 99th percentile band shaded and its modal bin marked. The distribution shifts to larger scores and broadens at every cycle, so the band is re-derived from the current representation}{figure.caption.15}{}}
